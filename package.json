{
  "engines": {
    "node": ">=22.0.0",
    "npm": ">=9.0.0"
  },
  "name": "otherland",
  "scripts": {
    "build": "npm run build --workspaces --if-present",
    "prebuild": "npm run prebuild --workspaces --if-present",
    "pretest": "npm run prebuild --workspaces --if-present",
    "start": "npm start --workspaces --if-present",
    "test": "npm test --workspaces --if-present",
    "mops:setup": "mops install && mops toolchain use moc 1.14.0",
    "generate": "mops generate candid && npm run generate --workspace otherland_client",
    "network:start": "icp network start -d",
    "network:stop": "icp network stop",
    "deploy": "icp deploy"
  },
  "type": "module",
  "workspaces": [
    "src/otherland_client"
  ],
  "devDependencies": {
    "esprima": "^4.0.1",
    "npm-check-updates": "^17.1.18",
    "vite": "^8.2.1"
  },
  "dependencies": {}
}
