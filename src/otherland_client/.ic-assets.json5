[
  {
    "match": "*.html",
    "headers": {
      "Content-Security-Policy": "default-src 'self'; script-src 'self' https://cdn.jsdelivr.net; object-src 'none'; connect-src 'self' 0.peerjs.com wss://0.peerjs.com http://localhost:8000 http://*.localhost:8000 http://id.ai.localhost:8000 https://id.ai https://icp0.io https://*.icp0.io https://icp-api.io https://cdn.jsdelivr.net blob:; font-src 'self' data:",
      "Permissions-Policy": "xr-spatial-tracking=(self)"
    },
    "security_policy": "hardened"
  },
  {
    "match": "*.js",
    "headers": {
      "Content-Security-Policy": "default-src 'self'; script-src 'self'; object-src 'none'; connect-src 'self' https://icp0.io https://*.icp0.io https://icp-api.io http://localhost:8000 http://*.localhost:8000;"
    },
    "security_policy": "hardened"
  },
  {
    "match": "*.css",
    "headers": {
      "Content-Security-Policy": "default-src 'self'; script-src 'self'; object-src 'none'; connect-src 'self' https://icp0.io https://*.icp0.io https://icp-api.io; font-src 'self' data:"
    },
    "security_policy": "hardened"
  },
  {
    "match": "**/*.woff2",
    "headers": {
      "Content-Type": "font/woff2",
      "Content-Security-Policy": "default-src 'self'; script-src 'self'; object-src 'none';"
    },
    "security_policy": "hardened"
  },
  {
    "match": "*.json",
    "headers": {
      "Content-Security-Policy": "default-src 'self'; object-src 'none';"
    },
    "security_policy": "hardened"
  },
  {
    "match": "*.ico",
    "headers": {
      "Content-Security-Policy": "default-src 'self'; object-src 'none';"
    },
    "security_policy": "hardened"
  },
  {
    "match": "*.png",
    "headers": {
      "Content-Security-Policy": "default-src 'self'; object-src 'none';"
    },
    "security_policy": "hardened"
  },
  {
    "match": "*.glb",
    "headers": {
      "Content-Security-Policy": "default-src 'self'; object-src 'none';"
    },
    "security_policy": "hardened"
  }
]
